# 复制此文件为 .env 并填入你的 API Key

# LLM API Key (推荐: 统一用此变量; 向后兼容下方 DEEPSEEK_API_KEY)
LLM_API_KEY=your_api_key_here

# DeepSeek (向后兼容: 若未设 LLM_API_KEY 则读此项)
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# LLM 服务地址与模型 (默认 DeepSeek; 改智谱请设 LLM_BASE_URL=https://open.bigmodel.cn + LLM_MODEL=glm-4.5-air)
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# 模型分层 (阶段3): fast=出题/评分(求速度), strong=总结报告(求质量, 可配 deepseek-reasoner)
LLM_MODEL_FAST=deepseek-chat
LLM_MODEL_STRONG=deepseek-chat

# 本地 BGE 嵌入模型路径 (留空则使用 Hub 自动下载 BAAI/bge-base-zh-v1.5)
# LOCAL_BGE_MODEL_PATH=D:/BGE_BASE_ZN_1.5/models--BAAI--bge-base-zh-v1.5/snapshots/f03589ceff5aac7111bd60cfc7d497ca17ecac65

# 视觉模型 (可选): 千问 qwen-vl, 用于扫描件/图片型 PDF 简历解析兜底
# 未配置 DASHSCOPE_API_KEY 时该功能自动禁用, 行为与之前一致
# DASHSCOPE_API_KEY=your_dashscope_key_here
# VISION_MODEL=qwen-vl-plus

# CORS 允许的前端来源 (逗号分隔)
CORS_ORIGINS=http://localhost:3001,http://127.0.0.1:3001

# ---- 认证 (v0.6, 均可省略) ----
# JWT 签名密钥: 留空则首次启动自动生成并写入 backend/.jwt_secret
# JWT_SECRET_KEY=change_me_to_a_long_random_string
# 令牌有效期 (小时, 默认 24)
# TOKEN_EXPIRE_HOURS=24
# 用户库路径 (默认 backend/users.db)
# AUTH_DB_PATH=

# ---- 统筹助手与 LangGraph 持久化 (均可省略) ----
# ASSISTANT_DB_PATH=E:/hiagent/DEMO3/TOtal/backend/assistant.db
# ASSISTANT_CHROMA_PATH=E:/hiagent/DEMO3/TOtal/backend/assistant_chroma
# CHECKPOINT_DB_PATH=E:/hiagent/DEMO3/TOtal/backend/checkpoints.db
# RESUME_DB_PATH=E:/hiagent/DEMO3/TOtal/backend/resumes.db
# 投递记录库 (建议开发环境显式指定; 运行产物不应提交)
# APPLICATION_DB_PATH=E:/hiagent/DEMO3/TOtal/backend/applications.db

# 单轮预算与工具上限
# ASSISTANT_MAX_ITERATIONS=6
# ASSISTANT_MAX_TOOL_CALLS=4
# ASSISTANT_TOKEN_BUDGET=8000
# ASSISTANT_TOOL_OUTPUT_CHARS=4000
# ASSISTANT_MEMORY_TOPK=5
# ASSISTANT_SUMMARY_TOKEN_THRESHOLD=6000
# ASSISTANT_SUMMARY_KEEP_MESSAGES=8
